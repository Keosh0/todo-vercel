# Пример переменных окружения. Скопируйте в .env.local и подставьте свои значения.
# На Vercel переменные задаются в Settings -> Environment Variables.

# Секретный ключ: читается только серверной функцией api/status.js и не попадает в код страницы.
API_KEY=your_secret_key

# Необязательно: адрес Express API из задания по Backend и ключ для заголовка x-api-key.
# Переменные с префиксом VITE_ встраиваются в сборку и видны в браузере.
VITE_API_URL=
VITE_API_KEY=
